# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Serial / ESP32
NEXT_PUBLIC_SERIAL_BAUD_RATE=115200
# Set to "mock" to use the fake ESP32 adapter, "real" for actual hardware
NEXT_PUBLIC_SERIAL_ADAPTER=mock

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Cron secret (set this in Vercel environment variables too)
CRON_SECRET=change-me-to-a-random-secret
